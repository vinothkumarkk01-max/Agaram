# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# NEXT_PUBLIC_ variables are safe to expose in the browser -- this is the
# publishable "anon" key, not a secret.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only -- powers self-serve account deletion (src/lib/supabase/admin.ts).
# This IS a secret: no NEXT_PUBLIC_ prefix, never expose it to the browser, and
# never put it anywhere other than this file / your host's env var settings.
# Same Project Settings -> API page, under "service_role secret".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Optional -- only needed if you want the /api/dev/seed-test-data (and
# seed-bulk-profiles) test-account utilities enabled (see README, "Test
# accounts (dev utility)"). Leave this unset and those routes always 404s and
# do nothing. If you do set it, pick your own long random value (never
# "changeme") and never commit it or share it. Sept 2026: these routes now
# ALSO hard-refuse to run in the Production Vercel environment regardless of
# this secret -- but still avoid setting this in Production at all; Preview
# deployments are the intended place to use it.
DEV_SEED_SECRET=

# Optional -- overrides the fixed password these two dev-seed utilities set on
# the fake test accounts they create (defaults to a hardcoded value in the
# route files if left unset). No reason to set this for normal use.
DEV_SEED_TEST_PASSWORD=
DEV_SEED_BULK_TEST_PASSWORD=

# Payments (Razorpay) -- see README, "Payments & the Elite paywall (Phase 5)".
# From the Razorpay dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional -- only needed for the auto-renewing subscription option on
# /upgrade (see README, "Subscription lifecycle: renewal & billing (V1)").
# Without these, the one-time-payment path above still works fine; the
# auto-renew checkbox just shows a "not configured yet" error if used.
# RAZORPAY_PLAN_ID is the Plan ID from Razorpay dashboard -> Subscriptions ->
# Plans (create one: Rs.15,000, "Monthly" period with interval 6).
# RAZORPAY_WEBHOOK_SECRET is shown when you create the webhook under
# Settings -> Webhooks (URL: https://<your-domain>/api/webhooks/razorpay;
# events: subscription.charged, subscription.cancelled,
# subscription.completed, subscription.halted).
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Optional -- only needed for browser push notifications on new messages
# (see README, "Push notifications for messages (V1)"). Generate a keypair
# with `npx web-push generate-vapid-keys` (pure crypto, no account needed).
# Without these, the "Message notifications" section on /account simply
# doesn't appear. NEXT_PUBLIC_VAPID_PUBLIC_KEY and VAPID_PUBLIC_KEY are the
# SAME value under two names -- one reaches the browser bundle, one stays
# server-only -- VAPID_PRIVATE_KEY is the one to actually keep secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional -- flips the Content-Security-Policy header from Report-Only to
# actually enforcing (see README, "Security pass" / "What's next"). Leave
# this unset until you've done a full manual click-through with the browser
# console open and seen zero CSP violations.
CSP_ENFORCE=

# Optional -- only needed for the two features that send email: work-email
# verification codes (see README, "Employment & education verification")
# and the weekly match digest (see README, "Weekly curated match digest").
# From resend.com -- create an account, verify a sending domain (Resend
# won't actually deliver mail for an unverified domain, just accept it),
# then create an API key. RESEND_FROM_ADDRESS must be an address at that
# verified domain, e.g. "Agaram <notifications@yourdomain.com>". Without
# these, both features show a clear "not configured yet" message instead
# of silently failing.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Optional -- only needed for the weekly digest email's cron trigger (see
# README, "Weekly curated match digest"). Pick your own long random value
# (never "changeme") and set the SAME value as a Vercel project env var --
# Vercel Cron (configured in vercel.json, no dashboard setup needed) sends
# it back automatically as an Authorization: Bearer header on every
# triggered run, and api/cron/weekly-digest checks it matches before doing
# anything. Without this set, the cron route does nothing and 200s.
CRON_SECRET=

# Optional -- only needed for the weekly digest's one-click, no-login
# "unsubscribe" link (see README, "Weekly curated match digest"). Pick your
# own long random value, separate from every other secret above -- it
# signs that link so anyone who opens it from their inbox can turn off
# their own digest emails without signing back in. Without this set, the
# digest still sends, but the unsubscribe link in it won't work (members
# can still turn it off from /account either way).
DIGEST_UNSUB_SECRET=
